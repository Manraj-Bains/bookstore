@page "/checkout"
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject NavigationManager NavigationManager
@inject IDbContextFactory<BookstoreDb> DbFactory
@inject CartService CartService
@rendermode InteractiveServer

<PageTitle>Bookstore - Checkout</PageTitle>

<h1>Bookstore - Checkout</h1>

@if (CartService.Items.Count == 0)
{
    <div class="alert alert-info">
        <p class="mb-0">Your cart is empty. Add some books to your cart first!</p>
        <a href="/" class="btn btn-primary mt-3">Browse Books</a>
    </div>
}
else
{
    <dl>
        @foreach (var item in CartService.Items)
        {
            var lineTotal = item.Book.Price * item.Quantity;
            <dt>@item.Book.Title</dt>
            <dd>@item.Quantity x @lineTotal.ToString("C")</dd>
        }
    </dl>
    <p class="fw-bold">Total: @CartService.GetCartTotal().ToString("C")</p>
    
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    
    <button @onclick="PlaceOrder" class="btn btn-success" disabled="@isProcessing">
        @if (isProcessing)
        {
            <span class="spinner-border spinner-border-sm me-2"></span>
        }
        Place Order
    </button>
}

@code {
    private BookstoreDb? context;
    private bool isProcessing;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        context = await DbFactory.CreateDbContextAsync();
    }

    private async Task PlaceOrder()
    {
        if (context is null || isProcessing) return;
        
        isProcessing = true;
        errorMessage = null;
        
        try
        {
            var order = new Order
            {
                OrderDate = DateTime.Now,
                OrderItems = CartService.Items.Select(i => new OrderItem
                {
                    BookId = i.Book.Id,
                    Quantity = i.Quantity,
                    TotalPrice = i.Book.Price * i.Quantity
                }).ToList()
            };

            context.Orders.Add(order);
            await context.SaveChangesAsync();
            
            CartService.ClearCart();
            NavigationManager.NavigateTo("/orders");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to place order: {ex.Message}";
            isProcessing = false;
        }
    }

    public async ValueTask DisposeAsync() 
    { 
        if (context is not null) 
        {
            await context.DisposeAsync(); 
        }
    }
}
